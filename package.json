{
  "name": "winemaker",
  "productName": "Winemaker",
  "version": "0.1.0",
  "description": "Помощник винодела — локальное десктоп-приложение",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "db:generate": "drizzle-kit generate",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac zip --arm64 --x64",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "dist:linux": "electron-vite build && electron-builder --linux deb tar.gz --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
